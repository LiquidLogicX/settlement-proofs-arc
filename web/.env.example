NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_SETTLEMENT_PROOFS_ADDRESS=
# Human UI root only — do not use explorer.arc.io/api (Cloudflare). Programmatic reads use ARC_RPC_URL.
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042
# 1A: srcTxHash is the Base payment tx
NEXT_PUBLIC_BASE_EXPLORER=https://basescan.org
# Base JSON-RPC used by the verifier to re-check Base payments (payer, amount)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Tempo Moderato testnet registry (SettlementProofs v2) — Tempo payment -> Tempo proof.
# Production must use v2. Legacy v1 (0x35d7…ce51) is superseded; see docs/deployments.md.
NEXT_PUBLIC_TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
NEXT_PUBLIC_TEMPO_EXPLORER=https://explore.testnet.tempo.xyz
NEXT_PUBLIC_TEMPO_CHAIN_ID=42431
NEXT_PUBLIC_TEMPO_SETTLEMENT_PROOFS_ADDRESS=0x2ec4CF47e6964b33FEd3718f07885ed44aF52c0b
# Log-scan floor (deploy block). Defaults to 38311217 for the v2 address.
NEXT_PUBLIC_TEMPO_REGISTRY_FROM_BLOCK=38311217
# ^ The NEXT_PUBLIC_TEMPO_* vars above feed the "Tempo testnet" tab (?network=tempo). Keep them on Moderato.

# Tempo mainnet tab (?network=tempo-mainnet). All optional: code defaults are the live mainnet
# registry below, so nothing needs to be set on Vercel. Override only to point at another deploy.
# NEXT_PUBLIC_TEMPO_MAINNET_SETTLEMENT_PROOFS_ADDRESS=0x9940a8fE88f8BE0bB8E05686631Fd638DC1DfE6A
# NEXT_PUBLIC_TEMPO_MAINNET_REGISTRY_FROM_BLOCK=42806697
# NEXT_PUBLIC_TEMPO_MAINNET_RPC_URL=https://rpc.tempo.xyz
# NEXT_PUBLIC_TEMPO_MAINNET_EXPLORER=https://explore.tempo.xyz
# NEXT_PUBLIC_TEMPO_MAINNET_CHAIN_ID=4217

# Which Tempo tab is listed first: auto (default) = Tempo mainnet once its registry has >= 1 proof,
# else Tempo testnet. Force with tempo-mainnet or tempo. Never rewrites ?network= links.
# NEXT_PUBLIC_TEMPO_DEFAULT_NETWORK=auto
