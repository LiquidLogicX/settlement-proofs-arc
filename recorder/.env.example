# Environment — names only. Never commit real keys.
# Two independent rails; configure at least one.
#   Arc rail   (1A): verify USDC payment on Base; notarize on Arc. 2B: public srcTxHash.
#   Tempo rail     : verify TIP-20 payment on Tempo; notarize on Tempo.

# --- Arc rail (leave SETTLEMENT_PROOFS_ADDRESS empty to disable) ---

BASE_RPC_URL=https://mainnet.base.org
ARC_RPC_URL=https://rpc.mainnet.arc.io
SETTLEMENT_PROOFS_ADDRESS=
SETTLEMENT_RECORDER_PRIVATE_KEY=

# --- Tempo rail (leave TEMPO_SETTLEMENT_PROOFS_ADDRESS empty to disable) ---
# Moderato v2 registry: 0x2ec4CF47e6964b33FEd3718f07885ed44aF52c0b
TEMPO_SETTLEMENT_PROOFS_ADDRESS=
# Wallet with RECORDER_ROLE on the Tempo registry; holds pathUSD for fees. Must differ from the Arc key.
TEMPO_RECORDER_PRIVATE_KEY=
# TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
# TEMPO_EXPLORER=https://explore.testnet.tempo.xyz
# TEMPO_MIN_CONFIRMATIONS=1
# TEMPO_FEE_TOKEN=0x20c0000000000000000000000000000000000000
# TEMPO_ALLOWED_TOKENS=0x20c0000000000000000000000000000000000000,0x20c0000000000000000000000000000000000001
# TEMPO_MIN_RECORDER_FEE_BALANCE=50000
# Chain 4217 (Tempo mainnet) is refused unless this is true. Leave unset.
# TEMPO_ALLOW_MAINNET=

# --- Shared ---
RECORDER_API_KEY=
PORT=10000
# PUBLIC_VERIFIER_URL=https://proofs.liquidlogicx.com

# Optional
# HOST=0.0.0.0
# MIN_CONFIRMATIONS=12
# Default 12 Base confirmations before recording. Raise for extra reorg safety.

# Do NOT set (removed under 1A+2B / Part 3):
# ALLOW_UNVERIFIED_AMOUNT
# VIEW_SALT_KEY
# VIEW_SALT_KEY_ID
# VIEW_SALT_KEY_<id>
