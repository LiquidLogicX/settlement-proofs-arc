# Environment — names only. Never commit real keys.
# 1A: verify payment on Base; notarize on Arc. 2B: public srcTxHash, no confidentiality.

BASE_RPC_URL=https://mainnet.base.org
ARC_RPC_URL=https://rpc.mainnet.arc.io
SETTLEMENT_PROOFS_ADDRESS=
SETTLEMENT_RECORDER_PRIVATE_KEY=
RECORDER_API_KEY=
PORT=10000

# Optional
# HOST=0.0.0.0
# MIN_CONFIRMATIONS=12
# Default 12 Base confirmations before recording. Raise for extra reorg safety.

# Do NOT set (removed under 1A+2B / Part 3):
# ALLOW_UNVERIFIED_AMOUNT
# VIEW_SALT_KEY
# VIEW_SALT_KEY_ID
# VIEW_SALT_KEY_<id>
